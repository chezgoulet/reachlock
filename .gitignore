# Mods (built packages)
*.reachmod

# Stray content trees written by tests/tools run from inside a crate
# directory. The content root is CWD-relative, so running the editor or its
# tests from `reachlock-editor/` creates `reachlock-editor/mods/`. Authored
# content lives at the repo root only.
reachlock-*/mods/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Local agent worktrees / session state — but path-scoped rules are shared
.claude/*
!.claude/rules/

# Runtime saves (S16B: the dev save was churning in every playtest commit)
save/

# Secrets and keys — never commit
.env
.env.*
*.pem
*.key
*.crt
credentials.*
secrets.*

# Runtime data
data/

# Logs
*.log
