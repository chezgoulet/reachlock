# ReachLock server — local development environment.
#
#   cp .env.example .env
#   make db
#   make server
#
# `.env` is gitignored. These values are DEVELOPMENT ONLY: the keys below are
# committed to a public repo, so treat anything signed or encrypted with them
# as public. Generate fresh ones for any deployment — `make dev-secrets` will
# print a new set.

# ── Stores ───────────────────────────────────────────────────────────────────
# Setting REACHLOCK_DB is the single switch that selects the Postgres stores.
# Unset = in-memory, zero infrastructure. Migrations run automatically at
# startup (sqlx::migrate! against reachlock-server/migrations/).
# Requires: cargo run -p reachlock-server --features postgres
REACHLOCK_DB=postgres://reachlock:reachlock@127.0.0.1:5432/reachlock

# Separate database, so the test battery never touches your dev data.
REACHLOCK_TEST_DB=postgres://reachlock:reachlock@127.0.0.1:5432/reachlock_test

# S50 sessions / rate limiting / presence. Optional; falls back to in-memory.
# Requires: --features redis
REACHLOCK_REDIS_URL=redis://127.0.0.1:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes). Encrypts TOTP secrets at rest — 2FA enrollment
# returns 503 without it.
REACHLOCK_SECRET_KEY=b63c71708aa66eeebcac63167dc7e7900b5c436f63f08b1dc70b126029c23b33

# 64 hex chars (32 bytes). Encrypts player-supplied LLM API keys (BYOK).
REACHLOCK_BYOK_KEY=aec9edf4cce2e81fe6f23457134e1b227be1496201b8a28624dd5c16cbc79776

# Bearer value for the /admin/* routes: `Authorization: Admin <this>`.
# Empty or unset disables admin access entirely.
REACHLOCK_ADMIN_KEY=dev-admin-key-change-me

# Signs billing entitlement tokens.
REACHLOCK_SERVER_SECRET=dev-server-secret-change-me

# ── Email ────────────────────────────────────────────────────────────────────
# Mailpit: no TLS, no auth, everything visible at http://localhost:8025.
# This is what makes the verification / password-reset / 2FA flows testable —
# unset it and the server writes files to data/emails instead.
REACHLOCK_SMTP_URL=smtp://127.0.0.1:1025
REACHLOCK_SMTP_FROM=noreply@reachlock.test

# Base URL for links inside those emails. Without it they point at
# http://localhost:40711, which is fine locally but wrong anywhere else.
REACHLOCK_PUBLIC_URL=http://localhost:40711

# ── Server ───────────────────────────────────────────────────────────────────
REACHLOCK_BIND=127.0.0.1:40711
REACHLOCK_TICK_SECS=5

# Require a session token on the WebSocket handshake. Leave unset while
# iterating; set to 1 to exercise the real auth path.
# REACHLOCK_AUTH=1

# Rate limiters key on the peer socket address. Only trust X-Forwarded-For
# from proxies listed here (comma-separated); unset means never trust it.
# REACHLOCK_TRUSTED_PROXIES=127.0.0.1

# CORS. Unset = same-origin only. Only needed if you serve tooling from
# another origin.
# REACHLOCK_ALLOWED_ORIGINS=http://localhost:5173

# Request body cap in bytes (default 1 MiB).
# REACHLOCK_MAX_BODY_BYTES=1048576

# ── Auth tuning (all optional; defaults in AuthConfig) ────────────────────────
# REACHLOCK_AUTH_MIN_PASSWORD_LENGTH=12
# REACHLOCK_AUTH_LOCKOUT_THRESHOLD=10
# REACHLOCK_AUTH_LOCKOUT_DURATION_MINS=15
# REACHLOCK_AUTH_SESSION_TTL_HOURS=24
# REACHLOCK_AUTH_DELETION_GRACE_DAYS=30

# ── Third-party (leave unset unless you are testing that integration) ─────────
# REACHLOCK_OAUTH_GOOGLE_CLIENT_ID=
# REACHLOCK_OAUTH_GOOGLE_CLIENT_SECRET=
# REACHLOCK_OAUTH_GITHUB_CLIENT_ID=
# REACHLOCK_OAUTH_GITHUB_CLIENT_SECRET=
# REACHLOCK_STRIPE_SECRET_KEY=
# REACHLOCK_STRIPE_WEBHOOK_SECRET=
