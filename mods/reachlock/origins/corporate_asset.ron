            (faction_id: "compact", delta: -15),
            (faction_id: "free_traders", delta: -10),
        ],
        starting_credits: 20000,
        ship_template: Some("corvette_mk2"),
        ship_seed: Some(34000001),
        starting_gear: [
            (item_id: "corporate_datapad", count: 1),
            (item_id: "executive_sidearm", count: 1),
            (item_id: "credit_chip", count: 1),
