{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Music Theme Content File",
  "description": "An authored music theme for the procedural audio engine",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "asset_type", "seed", "universe", "priority", "payload"],
  "properties": {
    "id": { "type": "string" },
    "display_name": { "type": "string" },
    "asset_type": { "type": "string", "enum": ["theme"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "universe": { "type": "string" },
    "priority": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme"],
      "properties": { "theme": { "type": "object" } }
    }
  }
}
