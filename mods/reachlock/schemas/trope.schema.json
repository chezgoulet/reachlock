{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trope Template Content File",
  "description": "An authored trope template for procedural narrative encounters (S40)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "asset_type", "seed", "universe", "priority", "payload"],
  "properties": {
    "id": { "type": "string" },
    "display_name": { "type": "string" },
    "asset_type": { "type": "string", "enum": ["trope"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "universe": { "type": "string" },
    "priority": { "type": "string", "enum": ["procedural", "curated", "event", "authoritative"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trope_type", "title_template", "narrative_template", "slots"],
      "properties": {
        "trope_type": { "type": "string" },
        "title_template": { "type": "string" },
        "narrative_template": { "type": "string" },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot_name", "slot_kind"],
            "properties": {
              "slot_name": { "type": "string" },
              "slot_kind": {
                "type": "string",
                "enum": ["Text", "PlanetName", "FactionName", "SpeciesName", "ShipName", "NpcName", "StationName", "SystemName", "ItemName", "GoodName"]
              },
              "constraints": {
                "type": "array",
                "items": { "type": "object" }
              }
            }
          }
        },
        "branches": {
          "type": "array",
          "items": { "type": "object" }
        },
        "base_frequency": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "min_threat_level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_threat_level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "dilemma_chance": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "location_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["DeepSpace", "PlanetSurface", "StationInterior", "AsteroidField", "Nebula", "Hyperspace"]
          }
        }
      }
    }
  }
}
