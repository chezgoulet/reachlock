{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storyline Content File",
  "description": "A faction storyline content file. The schema previously described a bare {version, storylines} catalog, which no authored file has ever been: storylines/*.ron are ContentFile envelopes carrying payload: storylines([...]).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "asset_type",
    "seed",
    "universe",
    "priority",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "storyline"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "universe": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "procedural",
        "curated",
        "event",
        "authoritative"
      ]
    },
    "expires_at": {
      "type": "integer"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storylines"
      ],
      "properties": {
        "storylines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "faction",
              "chapters"
            ],
            "properties": {
              "faction": {
                "type": "string"
              },
              "chapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "narration"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "trigger": {
                      "$ref": "#/definitions/ChapterTrigger"
                    },
                    "narration": {
                      "type": "string"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ChapterTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tick_after"
          ],
          "properties": {
            "tick_after": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_complete"
          ],
          "properties": {
            "chapter_complete": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "player_reputation"
          ],
          "properties": {
            "player_reputation": {
              "type": "object",
              "required": [
                "faction",
                "trust"
              ],
              "properties": {
                "faction": {
                  "type": "string"
                },
                "trust": {
                  "type": "integer"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ChapterTrigger"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ChapterTrigger"
              }
            }
          }
        }
      ]
    }
  }
}
