{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scripted Encounter Content File",
  "description": "An authored multi-scene scripted encounter (S41)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "asset_type", "seed", "universe", "priority", "payload"],
  "properties": {
    "id": { "type": "string" },
    "display_name": { "type": "string" },
    "asset_type": { "type": "string", "enum": ["scripted_encounter"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "universe": { "type": "string" },
    "priority": { "type": "string", "enum": ["procedural", "curated", "event", "authoritative"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "encounter_type", "scenes"],
      "properties": {
        "title": { "type": "string" },
        "encounter_type": {
          "type": "string",
          "enum": ["StoryBeat", "Combat", "Trade", "Investigation", "Rescue", "Exploration"]
        },
        "trigger": {
          "type": "string",
          "enum": ["Manual", "OnSystemEntry", "OnJump", "OnDock", "OnProximity", "OnTick"]
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scene_id", "narrative"],
            "properties": {
              "scene_id": { "type": "string" },
              "narrative": { "type": "string" },
              "speaker": { "type": "string" },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "outcome_scene", "immediate_consequences"],
                  "properties": {
                    "label": { "type": "string" },
                    "condition": { "type": "object" },
                    "outcome_scene": { "type": "string" },
                    "immediate_consequences": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "narrative_response": { "type": "string" }
                  }
                }
              },
              "time_pressure": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "on_complete": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repeatable": { "type": "boolean" },
        "cooldown_ticks": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
