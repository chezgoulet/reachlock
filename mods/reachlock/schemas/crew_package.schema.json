{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crew Package Content File",
  "description": "An authored crew package — a set of crew members that travel together",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "asset_type",
    "seed",
    "universe",
    "priority",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this crew package"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable name for display"
    },
    "asset_type": {
      "type": "string",
      "enum": ["crew_package"],
      "description": "Must be 'crew_package'"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "universe": {
      "type": "string",
      "description": "'all' or a universe tier name"
    },
    "priority": {
      "type": "string",
      "enum": ["procedural", "curated", "event", "authoritative"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crew_package"],
      "properties": {
        "crew_package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "description", "members"],
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique identifier for this crew package"
            },
            "name": {
              "type": "string",
              "description": "Human-readable display name"
            },
            "description": {
              "type": "string",
              "description": "Flavor text describing this crew"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["soul_id", "role"],
                "properties": {
                  "soul_id": {
                    "type": "string",
                    "description": "References a SoulFile by id"
                  },
                  "role": {
                    "type": "string",
                    "description": "Job title (e.g. Captain, Pilot)"
                  },
                  "duty_room": {
                    "type": ["string", "null"],
                    "description": "Optional room name where this crew member works"
                  },
                  "starting": {
                    "type": "boolean",
                    "description": "Whether this member starts with the player"
                  },
                  "salary": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Salary demand per pay period in credits"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
