    id: "keene",
    display_name: "Doc Keene",
    asset_type: soul,
    seed: 3178254019476633,
    universe: "all",
    priority: authoritative,
    payload: soul((
        id: "keene",
        name: "Ella Keene",
        species: human,
        portrait_id: "portraits/keene",
        identity: (
            origin: "West African diaspora — has never been to Earth and carries its politics personally",
            faction_affiliation: "The crew of the Loup-Garou",
            role: "Medic",
            public_bio: "Doc Keene is overqualified for this ship and has never explained why she is on it. Her credentials suggest inner-system trauma surgery — the kind of posting that does not get extended to people who end up on Class-J hulls in the Reach. The crew has stopped asking. The work is too good to risk the answer.",
        ),
        personality: (
            traits: ["Calm", "Restless", "Withholding"],
            values: ["TheWork", "Consent", "TheRecord"],
            speaking_style: warm,
            quirks: [
                "Calmest person aboard in a crisis, most restless in a long transit",
                "Runs the length of the lower corridor until she is tired",
                "Plays cards with Risc and loses in ways that look deliberate",
                "Reads constantly and never says what",
            ],
        ),
        emotional_state: (
            dominant_mood: stable,
            intensity: 358,
            triggers: [
                (
                    condition: compare(field: "event.crew_member_injured", op: eq, value: 1),
                    mood: focused,
                    intensity: 921,
                    priority: 10,
                ),
                (
