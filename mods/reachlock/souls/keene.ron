                    mood: suspicious,
                    intensity: 870,
                    priority: 9,
                ),
                (
                    condition: compare(field: "event.compact_medical_mentioned", op: eq, value: 1),
                    mood: tense,
                    intensity: 768,
                    priority: 8,
                ),
                (
                    condition: compare(field: "event.long_transit", op: eq, value: 1),
                    mood: anxious,
                    intensity: 460,
                    priority: 3,
                ),
            ],
        ),
        memory_tree: [
            (
                id: "the-records",
                event_type: "theft",
                player_involved: false,
                emotional_weight: 1024,
                timestamp: 0,
                summary: "She accessed the internal records of a Compact-affiliated medical institution, partially released them, and ran. She did not take the information for leverage. She took it because someone needed to.",
            ),
        ],
        relationship_graph: [
            (target_id: "bardo", trust: 946, familiarity: 972, history: []),
            (target_id: "risc", trust: 870, familiarity: 819, history: []),
            (target_id: "tib", trust: 794, familiarity: 717, history: []),
        ],
        goals: [
            (id: "keep_them_alive", priority: constant, description: "Whatever else is true about why she is here, this part is not complicated."),
            (id: "decide_about_the_records", priority: situational, description: "Evidence of experimental protocols run on non-consenting subjects in frontier settlements. She has not decided what to do with it."),
        ],
        breaking_points: [
            (
                id: "handed_to_the_compact",
                trigger: compare(field: "event.crew_negotiated_with_bounty_holder", op: eq, value: 1),
                reaction: leave_ship,
            ),
        ],
        backstory: "Her grandmother was a historian of the pre-colonial period. She and Bardo have discussed the blockade more than anyone else aboard, and they knew each other before either of them was on this ship. How is something neither has volunteered.",
        contracts: [],
        secrets: [
            (
                id: "the_bounty_is_hers",
                reveal_condition: all([
                    compare(field: "trust.player", op: gt, value: 897),
                    compare(field: "event.asked_who_the_bounty_is_for", op: eq, value: 1),
                ]),
                content: "The bounty is on her. It was placed by a Compact-affiliated medical institution whose records she accessed and partially released. The crew assumes it belongs to someone else aboard. She has let them.",
            ),
            (
                id: "before_the_ship",
                reveal_condition: all([
                    compare(field: "trust.player", op: gt, value: 819),
                    compare(field: "event.asked_about_bardo", op: eq, value: 1),
                ]),
                content: "She and Bardo were both present at something they do not discuss, in a place neither of them names. It is the reason she is on this ship.",
